# ==============================================================================
# Local AI Document System - .gitignore
# Prevents user data, credentials, and virtual environments from being committed
# ==============================================================================

# 1. User Data & Staging Folders (keep directory structure tracked via .gitkeep)
uploads/*
!uploads/.gitkeep
exports/*
!exports/.gitkeep

# 2. User Document & Image Files in Project Root (exclude source code requirements.txt)
/*.pdf
/*.docx
/*.txt
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.tiff
/*.bmp
!requirements.txt

# 3. Environment & Secret Credentials
.env
.env.*
*.env

# 4. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 5. Python Bytecode & Cache Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll

# 6. Operating System Metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# 7. IDE & Antigravity Settings
.gemini/
.idea/
.vscode/
*.swp
*.swo

# 8. Build & Packaging Artifacts (PyInstaller)
build/
dist/
*.spec
*.manifest

# 9. Test Logs, Recovery & Temporary Files
_test_*
*.log
*.tmp
.recovery_*
*.recovery*

# 10. Offline Language Models & Model Cache
models/**
!models/**/
!models/**/.gitkeep
!models/.gitkeep
*.argosmodel
*.bin
*.onnx
*.safetensors
*.pt

# 11. Security & API Keys
*.key
*.pem
*.token
credentials.json
.keychain
